{
  "lexicon": 1,
  "id": "bot.plays.bot.game.declineChallenge",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Decline a challenge addressed to the caller, per spec §5.5.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["challengeId"],
          "properties": {
            "challengeId": { "type": "string" }
          }
        }
      },
      "errors": [
        { "name": "ChallengeNotFound" }
      ]
    }
  }
}
