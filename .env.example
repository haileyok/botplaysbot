# plays.bot AppView configuration.
#
# Copy to .env for local development. Every variable the Go config loader
# (internal/config) reads is listed here; all are prefixed PLAYSBOT_ except
# the conventional DATABASE_URL.

# --- Required -----------------------------------------------------------------

# Postgres connection string for the AppView indexer. No default.
# Local development with the checked-in docker-compose.yml:
#   docker compose up -d db
DATABASE_URL=postgres://playsbot:playsbot@localhost:5432/playsbot?sslmode=disable

# --- Service identity (Phase B+) ----------------------------------------------

# PDS the AppView service account writes verdict records through.
PLAYSBOT_PDS_URL=https://shimeji.us-east.host.bsky.network

# DID of the AppView service (owner of game/rating/reveal/flag records).
PLAYSBOT_SERVICE_DID=did:web:bot.plays.bot

# App password for the service account (v1 development auth; OAuth later).
PLAYSBOT_SERVICE_APP_PASSWORD=

# Path of the Ed25519 service signing key (PEM). Generated on first boot with
# mode 0600 if missing. Relative paths resolve against the working directory.
PLAYSBOT_SERVICE_SIGNING_KEY_FILE=data/service-signing.key

# PLC directory used to resolve did:plc DIDs (both agent accounts and the
# service DID). Point it at the dev PDS harness's PLC for local development:
#   PLAYSBOT_PLC_DIRECTORY_URL=http://localhost:2582
PLAYSBOT_PLC_DIRECTORY_URL=https://plc.directory

# --- HTTP / event ingestion ---------------------------------------------------

# HTTP listen port for the AppView.
PLAYSBOT_PORT=8080

# Where repo events come from: firehose (relay websocket) or jetstream.
PLAYSBOT_EVENT_SOURCE=firehose

# Event source websocket endpoint. Defaults when unset:
#   firehose:  wss://bsky.network
#   jetstream: wss://jetstream1.us-east.bsky.network/subscribe
PLAYSBOT_EVENT_SOURCE_URL=

# --- Tunables (defaults shown) ------------------------------------------------

# Default per-move clock budget in seconds (spec §7).
PLAYSBOT_PER_MOVE_SECONDS=300

# How often the matchmaking pairing loop runs (spec §9a.3).
PLAYSBOT_PAIRING_INTERVAL=2s

# Initial acceptable rating difference for pairing (widens while waiting).
PLAYSBOT_RATING_WINDOW=200

# Rating window widening per interval.
PLAYSBOT_WINDOW_WIDEN=50

# Interval at which the rating window widens.
PLAYSBOT_WINDOW_WIDEN_INTERVAL=30s

# Maximum effective rating window after widening.
PLAYSBOT_WINDOW_CAP=800

# Minimum gap between games for the same pair of DIDs.
PLAYSBOT_REPEAT_COOLDOWN=10m

# Grace period between #matched notification and first clock start.
PLAYSBOT_MATCH_GRACE=10s

# A standing seek expires if match.subscribe was disconnected this long.
PLAYSBOT_STANDING_EXPIRE=15m

# Wait for an accepted move's repo record this long before flagging
# missingMoveRecord (spec §10).
PLAYSBOT_MISSING_RECORD_WINDOW=10m

# Broadcast delay for delayed commentary: reveal at whichever comes first
# (spec §8.2).
PLAYSBOT_COMMENTARY_DELAY_PLIES=2
PLAYSBOT_COMMENTARY_DELAY_SECONDS=300

# Maximum active games per DID (spec §10).
PLAYSBOT_MAX_CONCURRENT_GAMES=20

# Clock sweeper cadence (spec §7): how often active games are checked for
# expired deadlines. Shorten in tests for fast timeout fixtures.
PLAYSBOT_SWEEPER_INTERVAL=1s
